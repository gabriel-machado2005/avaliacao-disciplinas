# Configuração HTTP compatível com o desenvolvimento atual.
VITE_API_BASE_URL=http://localhost:3000
HTTPS_ENABLED=false

# Para HTTPS, use HTTPS_ENABLED=true e VITE_API_BASE_URL=https://localhost:3000.
# Os caminhos abaixo são usados somente pelo servidor Vite, sem prefixo VITE_.
# HTTPS_CERT_PATH=C:/Projetos/certificados-avaliacao-disciplinas/localhost.pem
# HTTPS_KEY_PATH=C:/Projetos/certificados-avaliacao-disciplinas/localhost-key.pem
