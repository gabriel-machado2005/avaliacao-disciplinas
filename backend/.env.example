
# Configuração do PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha
DB_DATABASE=avaliacao_disciplinas

# Autenticação JWT
JWT_SECRET=substitua-por-um-segredo-longo-e-aleatorio

# Servidor local: use HTTPS_ENABLED=true apenas com certificado e chave válidos.
PORT=3000
HTTPS_ENABLED=false
CORS_ORIGIN=http://localhost:5173
# Ao habilitar HTTPS, use CORS_ORIGIN=https://localhost:5173 e preencha:
# HTTPS_CERT_PATH=C:/Projetos/certificados-avaliacao-disciplinas/localhost.pem
# HTTPS_KEY_PATH=C:/Projetos/certificados-avaliacao-disciplinas/localhost-key.pem
